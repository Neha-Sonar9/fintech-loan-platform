pipeline {
    agent {
        label 'docker-agent'
    }

    environment {
        SERVICE_NAME = 'customer-service'
        SERVICE_DIR = 'services/customer-service'
        IMAGE_NAME = 'customer-service'
        IMAGE_TAG = ''
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Run Unit Tests') {
            steps {
                dir("${SERVICE_DIR}") {
                    sh './mvnw clean test'
                }
            }
        }

        stage('Build JAR') {
            steps {
                dir("${SERVICE_DIR}") {
                    sh './mvnw clean package'
                }
            }
        }

        stage('Verify Git Commit') {
            steps {
               sh 'git log -1 --oneline'
               sh 'git rev-parse --short HEAD'
               sh "echo 'Jenkins Build Number: ${BUILD_NUMBER}'"
            }
        }

        stage('Generate Image Tag') {
            steps {
                script {
                    env.IMAGE_TAG = sh(
                       script: 'echo "${BUILD_NUMBER}-$(git rev-parse --short HEAD)"',
                       returnStdout: true
                    ).trim()

                    echo "Generated Image Tag: ${env.IMAGE_TAG}"
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir("${SERVICE_DIR}") {
                    sh "docker build -t ${IMAGE_NAME}:${env.IMAGE_TAG} ."
                }
            }
        }

        stage('Verify Docker Image') {
            steps {
                sh "docker images | grep ${IMAGE_NAME}"
            }
        }
    }

    post {
        success {
            echo "CI pipeline completed successfully for ${SERVICE_NAME}"
        }

        failure {
            echo "CI pipeline failed for ${SERVICE_NAME}"
        }
    }
}