pipeline {
    agent any

    environment {
        SERVICE_NAME = 'customer-service'
        SERVICE_DIR = 'services/customer-service'
        IMAGE_NAME = 'customer-service'
        IMAGE_TAG = ''
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Run Unit Tests') {
            steps {
                dir("${SERVICE_DIR}") {
                    sh './mvnw clean test'
                }
            }
        }

        stage('Build JAR') {
            steps {
                dir("${SERVICE_DIR}") {
                    sh './mvnw clean package'
                }
            }
        }

        stage('Generate Image Tag') {
            steps {
                script {
                    GIT_COMMIT_SHORT = sh(
                       script: 'git rev-parse --short HEAD',
                       returnStdout: true
                    ).trim()

                    env.IMAGE_TAG = "${BUILD_NUMBER}-${GIT_COMMIT_SHORT}"

            echo "Generated Image Tag: ${env.IMAGE_TAG}"
        }
    }
}

        stage('Build Docker Image') {
            steps {
                dir("${SERVICE_DIR}") {
                    sh "docker build -t ${IMAGE_NAME}:${env.IMAGE_TAG} ."
                }
            }
        }

        stage('Verify Docker Image') {
            steps {
                sh "docker images | grep ${IMAGE_NAME}"
            }
        }
    }

    post {
        success {
            echo "CI pipeline completed successfully for ${SERVICE_NAME}"
        }

        failure {
            echo "CI pipeline failed for ${SERVICE_NAME}"
        }
    }
}