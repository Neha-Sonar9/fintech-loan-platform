def IMAGE_TAG_VALUE = ''

pipeline {
    agent {
        label 'docker-agent'
    }

    environment {
        DOCKER_BUILDKIT = '0'
        DOCKERHUB_REPO = 'nsonar/customer-service'
        SERVICE_NAME = 'customer-service'
        SERVICE_DIR = 'services/customer-service'
        IMAGE_NAME = 'customer-service'
        K8S_NAMESPACE = 'fintech-dev'
        K8S_DEPLOYMENT = 'customer-service'
        K8S_CONTAINER = 'customer-service'
        GIT_AUTHOR_NAME = 'jenkins-ci'
        GIT_AUTHOR_EMAIL = 'jenkins-ci@example.com'
        GIT_COMMITTER_NAME = 'jenkins-ci'
        GIT_COMMITTER_EMAIL = 'jenkins-ci@example.com'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Run Unit Tests') {
            steps {
                dir("${SERVICE_DIR}") {
                    sh './mvnw clean test'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir("${SERVICE_DIR}") {
                    withSonarQubeEnv('sonarqube') {
                        sh './mvnw sonar:sonar -Dsonar.projectKey=customer-service -Dsonar.projectName=customer-service'
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Build JAR') {
            steps {
                dir("${SERVICE_DIR}") {
                    sh './mvnw clean package'
                }
            }
        }

        stage('Generate Image Tag') {
            steps {
                script {
                    IMAGE_TAG_VALUE = sh(
                        script: 'echo "${BUILD_NUMBER}-$(git rev-parse --short HEAD)"',
                        returnStdout: true
                    ).trim()

                    echo "Generated Image Tag: ${IMAGE_TAG_VALUE}"
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir("${SERVICE_DIR}") {
                    script {
                        sh "docker build -t ${IMAGE_NAME}:${IMAGE_TAG_VALUE} ."
                    }
                }
            }
        }

        stage('Verify Docker Image') {
            steps {
                script {
                    sh "docker images | grep ${IMAGE_TAG_VALUE}"
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                script {
                    sh """
                        trivy image \
                        --scanners vuln \
                        --timeout 15m \
                        --severity HIGH,CRITICAL \
                        ${IMAGE_NAME}:${IMAGE_TAG_VALUE}
                    """
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                script {
                    withCredentials([usernamePassword(
                        credentialsId: 'nsonar-dockerhub-credentials',
                        usernameVariable: 'DOCKERHUB_USERNAME',
                        passwordVariable: 'DOCKERHUB_PASSWORD'
                    )]) {
                        sh '''
                            echo "$DOCKERHUB_PASSWORD" | docker login -u "$DOCKERHUB_USERNAME" --password-stdin
                        '''

                        sh """
                            docker tag ${IMAGE_NAME}:${IMAGE_TAG_VALUE} ${DOCKERHUB_REPO}:${IMAGE_TAG_VALUE}
                        """

                        sh """
                            docker push ${DOCKERHUB_REPO}:${IMAGE_TAG_VALUE}
                        """
                    }
                }
            }
        }

        stage('Update Helm Image Tag in Git') {
            steps {
                script {
                   withCredentials([usernamePassword(
                      credentialsId: 'github-push-credentials',
                      usernameVariable: 'GIT_USERNAME',
                      passwordVariable: 'GIT_TOKEN'
            )]) {
                sh """
                    git config user.name "${GIT_AUTHOR_NAME}"
                    git config user.email "${GIT_AUTHOR_EMAIL}"

                    sed -i 's/tag: .*/tag: ${IMAGE_TAG_VALUE}/' helm/customer-service/values.yaml

                    git status
                    git add helm/customer-service/values.yaml
                    git commit -m "chore: update customer-service image tag to ${IMAGE_TAG_VALUE}" || echo "No changes to commit"

                    git push https://${GIT_USERNAME}:${GIT_TOKEN}@github.com/Neha-Sonar9/fintech-loan-platform.git HEAD:develop
                """
            }
        }
    }
}
    }

    post {
        success {
            echo "CI pipeline completed successfully for ${SERVICE_NAME}. Image tag: ${IMAGE_TAG_VALUE}"
        }

        failure {
            echo "CI pipeline failed for ${SERVICE_NAME}"
        }
    }
}